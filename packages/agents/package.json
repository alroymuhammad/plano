    "eval:record": "tsx --env-file=../../.env src/evals/find-documents/record.ts",
    "test": "tsx --env-file=../../.env --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@anvia/core": "^1.23.0",
    "@anvia/gemini": "^1.2.1",
    "@anvia/openai": "^1.4.1",
    "@anvia/qdrant": "^1.3.0",
    "@napi-rs/canvas": "^1.2.0",
    "@tavily/core": "^1.1.0",
    "tesseract.js": "^7.0.0",
    "unpdf": "^2.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anvia/studio": "^1.5.2",
    "@plano/db": "workspace:*",
    "@plano/observability": "workspace:*",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
