{
  "name": "@plano/agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "dev:studio": "tsx watch --env-file=../../.env src/studio.ts",
