{
  "name": "plano",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter api dev",
    "dev:platform": "pnpm --filter platform dev",
    "dev:studio": "pnpm --filter @plano/agents dev:studio",
    "db:generate": "pnpm --filter @plano/db generate",
    "db:migrate": "pnpm --filter @plano/db migrate",
    "db:studio": "pnpm --filter @plano/db studio",
    "eval:find-docs": "pnpm --filter @plano/agents eval",
    "lens:up": "docker compose -f lens/docker-compose.yml up -d",
    "lens:down": "docker compose -f lens/docker-compose.yml down",
    "build": "pnpm -r build",
    "lint": "oxlint",
    "format": "oxlint --fix && oxfmt"
  },
  "devDependencies": {
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0"
  }
}
