# Self-hosted Anvia Lens for local development (decision 0013).
# Copy to lens/.env and replace every secret with its own random value.
# Full option reference: https://raw.githubusercontent.com/anvia-hq/lens/v0.20.1/.env.example

LENS_VERSION=0.20.1
LENS_PULL_POLICY=missing
SYSTEM_MONITOR_DATA_PATH=/var/lib/docker

PUBLIC_APP_URL=http://localhost:8082
WEB_ORIGIN=http://localhost:8082
WEB_PORT=127.0.0.1:8082

# openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-random-hex-value
CLICKHOUSE_PASSWORD=replace-with-a-random-hex-value
REDIS_PASSWORD=replace-with-a-random-hex-value
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
INGESTION_KEY_PEPPER=replace-with-an-independent-random-secret
# printf 'lens-key-1:%s\n' "$(openssl rand -base64 32)"
LENS_ALERT_SECRET_KEY=replace-with-kid-and-base64-of-32-random-bytes
