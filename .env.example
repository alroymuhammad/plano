DATABASE_URL=postgres://plano:plano@localhost:54329/plano
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
BETTER_AUTH_URL=http://localhost:3000
PLATFORM_URL=http://localhost:5173

GATEWAY_BASE_URL=https://gateway.devscale.id/v1
GATEWAY_API_KEY=

TAVILY_API_KEY=

# Gemini, for embeddings only (decision 0022). Chat models use GATEWAY_* above.
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Qdrant (decision 0020). Local: `docker compose up -d qdrant`, no key.
# Qdrant Cloud: the cluster URL (https://...cloud.qdrant.io:6333) plus a database API key.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Anvia Lens (lens/). Keys come from the Lens UI: project > Connect.
# Lens stays off while these three are empty; fill all three to turn it on (local: http://localhost:8082).
ANVIA_LENS_BASE_URL=
ANVIA_LENS_PUBLIC_KEY=
ANVIA_LENS_SECRET_KEY=
# Optional. Service name in Lens traces, defaults to plano.
ANVIA_LENS_SERVICE_NAME=
